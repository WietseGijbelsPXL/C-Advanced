<Window x:Class="LibraryManager.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryManager.Wpf"
        mc:Ignorable="d"
        Loaded="OnWindowLoaded"
        Title="Library Manager" Height="500" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Left side: ListBox for MediaItems -->
        <GroupBox Grid.Column="0" Grid.RowSpan="2" Header="Library Items" Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="libraryItemsListBox"
                         Grid.Row="0"
                         SelectionChanged="OnLibraryItemsListBoxSelectionChanged"
                         Margin="0,0,0,5"/>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Isbn:" FontWeight="Bold" />
                    <TextBox x:Name="newBookIsbnTextBox" 
                             Grid.Column="1"
                             Padding="1" Margin="5"/>
                    <Label Content="Locatie:" FontWeight="Bold"
                           Grid.Row="1"/>
                    <TextBox x:Name="newBookLocationTextBox"
                               Grid.Column="1" Grid.Row="1"
                               Padding="1" Margin="5"/>
                    <Button x:Name="addBookButton" 
                            Grid.Column="2"
                            Grid.RowSpan="2"
                            Content="Add new book" 
                            Padding="5" 
                            Margin="5"
                            Click="OnAddBookButtonClicked"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Right side: GroupBox for selected item -->
        <GroupBox Grid.Column="2" Grid.Row="0" Header="Item details" Padding="10">
            <StackPanel>
                <!-- Selected Item Info -->
                <TextBlock Text="Selected Item:" FontWeight="Bold" Padding="1" Margin="0,0,0,10"/>

                <!-- Common Properties -->
                <Grid x:Name="commonPropertiesGrid" Visibility="Hidden">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" Padding="1" Margin="0,0,10,5" VerticalAlignment="Center"/>
                    <TextBox x:Name="titleTextBox" Grid.Row="0" Grid.Column="1" Padding="1" IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Year:" Padding="1" Margin="0,0,10,5" VerticalAlignment="Center"/>
                    <TextBox x:Name="yearTextBox" Grid.Row="1" Grid.Column="1" Padding="1" IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Genre:" Padding="1" Margin="0,0,10,5" VerticalAlignment="Center"/>
                    <TextBox x:Name="genreTextBox" Grid.Row="2" Grid.Column="1" Padding="1" IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Location:" Padding="1" Margin="0,0,10,5" VerticalAlignment="Center"/>
                    <TextBox x:Name="locationTextBox" Grid.Row="3" Grid.Column="1" Padding="1" IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,5"/>
                </Grid>

                <!-- Book-specific Properties -->
                <Grid x:Name="bookPropertiesGrid" Visibility="Collapsed" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Author:" Padding="1" Margin="0,0,10,5" VerticalAlignment="Center"/>
                    <TextBox x:Name="authorTextBox" Grid.Row="0" Grid.Column="1" Padding="1" IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ISBN:" Padding="1" Margin="0,0,10,5" VerticalAlignment="Center"/>
                    <TextBox x:Name="isbnTextBox" Grid.Row="1" Grid.Column="1" Padding="1" IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,5"/>
                </Grid>

                <!-- Game-specific Properties -->
                <Grid x:Name="gamePropertiesGrid" Visibility="Collapsed" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Platform:" Padding="1" Margin="0,0,10,5" VerticalAlignment="Center"/>
                    <TextBox x:Name="platformTextBox" Grid.Row="0" Grid.Column="1" Padding="1" IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="PEGI:" Padding="1" Margin="0,0,10,5" VerticalAlignment="Center"/>
                    <TextBox x:Name="pegiTextBox" Grid.Row="1" Grid.Column="1" Padding="1" IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,5"/>
                </Grid>

                <!-- Magazine-specific Properties -->
                <Grid x:Name="magazinePropertiesGrid" Visibility="Collapsed" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Issue:" Padding="1" Margin="0,0,10,5" VerticalAlignment="Center"/>
                    <TextBox x:Name="issueNumberTextBox" Grid.Row="0" Grid.Column="1" Padding="1" IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,5"/>
                </Grid>

               
            </StackPanel>
        </GroupBox>

        <!-- Right side: GroupBox for loaning -->
        <GroupBox Grid.Column="2" Grid.Row="1" Header="Loan Item" Padding="10">
            <StackPanel>
                <!-- Loan Status -->
                <TextBlock Text="Loan Status:" FontWeight="Bold" Padding="1" Margin="0,5,0,5"/>
                <TextBox x:Name="loanStatusTextBox" 
                         Padding="1"
                         IsReadOnly="True" 
                         Background="#F0F0F0"/>

                <Separator Margin="0,10,0,10"/>

                <!-- Member Selection -->
                <TextBlock Text="Select Member:" FontWeight="Bold" Padding="1" Margin="0,0,0,5"/>
                <ComboBox x:Name="memberComboBox" Padding="1"
                          Height="20"
                          DisplayMemberPath="FullName"
                          Margin="0,0,0,10"/>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="loanButton" 
             Content="Loan Item" 
             Width="100" 
             Height="35" 
             Click="OnLoanButtonClicked"
             Margin="0,0,10,0"
             IsEnabled="False"/>
                    <Button x:Name="returnButton"
             Content="Return Item" 
             Width="100" 
             Height="35" 
             Click="OnReturnButtonClicked"
             IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
