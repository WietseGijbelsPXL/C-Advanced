<Window x:Class="DevShelf.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DevShelf.UI"
        mc:Ignorable="d"
        Title="DevShelf" Height="550" Width="800" Loaded="Window_Loaded">
    <DockPanel>
        <StackPanel x:Name="filterPanel" DockPanel.Dock="Right" Margin="10" Width="200">
            <GroupBox Header="Sorteren">
                <StackPanel>
                    <Button Content="Titel (A-Z)" Margin="5" Padding="5" x:Name="sortTitleAscButton" Click="sortTitleAscButton_Click"/>
                    <Button Content="Titel (Z-A)" Margin="5" Padding="5" x:Name="sortTitleDescButton" Click="sortTitleDescButton_Click"/>
                    <Button Content="Jaar" Margin="5" Padding="5" x:Name="sortYearAscButton" Click="sortYearAscButton_Click"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Filter">
                <StackPanel>
                    <Label Content="Titel:"/>
                    <TextBox x:Name="titleTextBox" Padding="2" Margin="5,0,5,10" TextChanged="titleTextBox_TextChanged"/>
                    <Label Content="Autheur:"/>
                    <ComboBox x:Name="authorComboBox" Padding="2" Margin="5,0,5,10" SelectionChanged="authorComboBox_SelectionChanged"/>
                    <Label Content="Minimum beoordeling:"/>
                    <Slider x:Name="ratingSlider" Minimum="0" Maximum="5" SmallChange="1" AutoToolTipPrecision="1" TickFrequency="0.1" IsSnapToTickEnabled="True" LargeChange="5" AutoToolTipPlacement="BottomRight" TickPlacement="Both" ValueChanged="ratingSlider_ValueChanged"/>
                    <Label Content="Boeken per pagina:"/>
                    <TextBox x:Name="itemsPerPageTextBox" Padding="2" Margin="5,0,5,10" TextChanged="itemsPerPageTextBox_TextChanged"/>
                    <Button Content="Toepassen" Margin="5" Padding="5" Click="applyFilterButton_Clicked"/>
                    <Button Content="Leeg maken" Margin="5" Padding="5" Click="clearFilterButton_Clicked"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" x:Name="paginationPanel" DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="firstPageButton" Content="First" Width="100" Padding="5" Click="firstPageButton_Click"/>
            <Button x:Name="previousPageButton" Content="Vorige" Width="100" Padding="5" Click="previousPageButton_Click"/>
            <TextBlock x:Name="pageTextBlock" Text="" Width="100" Padding="5" TextAlignment="Center"/>
            <Button x:Name="nextPageButton" Content="Volgende" Width="100" Padding="5" Click="nextPageButton_Click"/>
            <Button x:Name="lastPageButton" Content="Laaste" Width="100" Padding="5" Click="lastPageButton_Click"/>
        </StackPanel>

        <DataGrid x:Name="booksDataGrid" Margin="10" CanUserSortColumns="False" CanUserReorderColumns="False"/>
    </DockPanel>
</Window>