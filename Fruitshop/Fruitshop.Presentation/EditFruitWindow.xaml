<Window x:Class="Fruitshop.Presentation.EditFruitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fruitshop.Presentation"
        mc:Ignorable="d"
        Title="EditFruitWindow" Height="150" Width="200">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" HorizontalAlignment="Right">
            <Button x:Name="okButton" Content="OK" Margin="3" Click="okButton_Click"/>
            <Button x:Name="cancelButton" Content="Cancel" Margin="3" Click="cancelButton_Click"/>
        </StackPanel>
        <StackPanel>
            <WrapPanel>
                <TextBlock Text="Naam:" MinWidth="60" Margin="5"/>
                <TextBox x:Name="nameTextBox" MinWidth="100" Margin="5"/>
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Kleur:" MinWidth="60" Margin="5"/>
                <TextBox x:Name="colorTextBox" MinWidth="100" Margin="5"/>
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Seizoen:" MinWidth="60" Margin="5"/>
                <TextBox x:Name="seasonTextBox" MinWidth="100" Margin="5"/>
            </WrapPanel>
        </StackPanel>
    </DockPanel>
</Window>
