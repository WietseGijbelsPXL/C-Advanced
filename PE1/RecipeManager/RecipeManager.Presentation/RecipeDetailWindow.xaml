<Window x:Class="RecipeManager.Presentation.RecipeDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RecipeManager.Presentation"
        mc:Ignorable="d"
        Title="Recept Detail" Height="400" Width="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Naam:" FontWeight="Bold"/>
        <TextBlock x:Name="nameTextBlock" Grid.Column="1"/>
        <TextBlock Text="Voorbereidingstijd:" Grid.Row="1" FontWeight="Bold" Margin="0,0,5,0"/>
        <TextBlock x:Name="preparationTimeTextBlock" Grid.Row="1" Grid.Column="1"/>
        <TextBlock Text="Moeilijkheid:" Grid.Row="2" FontWeight="Bold"/>
        <TextBlock x:Name="difficultyTextBlock" Grid.Row="2" Grid.Column="1"/>
        <GroupBox Header="Ingrediënten" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <ListBox x:Name="ingredientsListBox"/>
        </GroupBox>
    </Grid>
</Window>
